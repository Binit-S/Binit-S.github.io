---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WipeRow from '../components/ui/WipeRow.astro';
import { formatMonthYear, byNewest } from '../data/posts.js';

const posts = (await getCollection('posts')).sort(byNewest);

let previous = '';
const logs = posts.map((post) => {
  const group = formatMonthYear(post.data.date);
  const label = group === previous ? '' : group;
  previous = group;
  return { id: post.id, title: post.data.title, label };
});
---

<Base title="Archive // Binit S." description="Logs of learning, building and shipping systems.">
  <div class="page">
    <Nav />

    <main class="split">
      <div class="left">
        <div class="hero">
          <h1>Archive</h1>
          <div class="rule"></div>
        </div>
        <p>An archive of learning , building and shipping systems</p>
      </div>

      <div class="divider"></div>

      <div class="right">
        <h2>Logs</h2>

        <div class="logs">
          {
            logs.map((log) => (
              <WipeRow
                columns="140px minmax(0, 1fr)"
                href={`/posts/${log.id}`}
                cells={[
                  { role: 'lead', text: log.label },
                  { role: 'main', text: log.title },
                ]}
              />
            ))
          }
        </div>

        <div class="status">&gt; writing code <span>...</span></div>
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .split {
    flex: 1;
    display: flex;
    min-height: 0;
  }

  .left {
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: var(--pad-x);
  }

  .hero {
    width: fit-content;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7.5vw, 120px);
    line-height: 1;
    margin: 0;
  }

  .rule {
    width: 4.5vw;
    min-width: 60px;
    height: 5px;
    background: var(--orange);
    margin: 10px 0 0 auto;
  }

  .left p {
    max-width: 34ch;
    margin: 5vh 0 0;
    padding-left: 20px;
    border-left: 2px solid rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .divider {
    width: 1px;
    background: var(--line);
  }

  .right {
    width: 50%;
    display: flex;
    flex-direction: column;
    padding: 10vh 6vw 4vh 4vw;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .right::-webkit-scrollbar {
    display: none;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--orange);
    margin: 0 0 5vh;
  }

  .logs {
    flex: 1;
    --wipe-main-font: var(--font-mono);
    --wipe-main-size: clamp(13px, 1.05vw, 17px);
    --wipe-main-weight: 700;
    --wipe-main-spacing: 0.05em;
    --wipe-main-transform: uppercase;
    --wipe-pad: 15px 0;
  }

  .status {
    margin-top: 4vh;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--orange);
  }

  .status span {
    animation: blink 1.2s infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .split {
      flex-direction: column;
    }

    .left,
    .right {
      width: 100%;
    }

    .left {
      padding: 14vh var(--pad-x) 8vh;
    }

    .divider {
      width: 100%;
      height: 1px;
    }

    .right {
      padding: 8vh var(--pad-x);
      overflow: visible;
    }
  }
</style>
