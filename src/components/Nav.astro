---
import { nav, site } from '../data/site.js';

// Section anchors only resolve on the home page; elsewhere they need to go there first.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onHome = path === '/';
const link = (href) => (href.startsWith('#') && !onHome ? `/${href}` : href);
const isCurrent = (href) => href.replace(/\/+$/, '') === path;
---

<nav data-nav>
  <a class="brand" href={link('#hero')}>{site.brand}</a>

  <div class="right">
    <div class="links">
      {
        nav.map((item) => (
          <a href={link(item.href)} class:list={{ active: isCurrent(item.href) }}>
            {item.label}
          </a>
        ))
      }
    </div>

    <button class="toggle" data-nav-toggle aria-label="Menu" aria-expanded="false">
      <span></span><span></span>
    </button>

    <div class="panel" data-nav-panel>
      {
        nav.map((item) => (
          <a href={link(item.href)} class:list={{ active: isCurrent(item.href) }}>
            <span>{item.label}</span>
            <span class="ar">→</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 999;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    width: 100%;
    padding: 20px var(--pad-x);
    background: rgba(11, 11, 11, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .right {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .links {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    transition: opacity 0.38s ease, transform 0.38s var(--ease);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #c8c8c8;
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--orange);
  }

  .links a.active {
    color: var(--orange);
  }

  .toggle {
    position: absolute;
    right: 0;
    top: 50%;
    margin-top: -17px;
    width: 34px;
    height: 34px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 2px;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
    transition: opacity 0.38s ease, transform 0.38s var(--ease);
  }

  .toggle:hover {
    border-color: var(--orange);
  }

  .toggle span {
    display: block;
    width: 15px;
    height: 1px;
    background: var(--text);
  }

  nav.collapsed .links {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  nav.collapsed .toggle {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 14px);
    display: flex;
    flex-direction: column;
    min-width: 196px;
    padding: 6px;
    background: rgba(9, 9, 10, 0.98);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    transition: opacity 0.28s ease, transform 0.28s var(--ease);
  }

  .panel.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .panel a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 11px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #c8c8c8;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .panel a:hover {
    background: rgba(252, 74, 37, 0.1);
    color: var(--orange);
  }

  .panel a.active {
    color: var(--orange);
  }

  .panel .ar {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .panel a:hover .ar {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .links {
      display: none;
    }

    .toggle {
      position: static;
      margin-top: 0;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-nav-panel]');

  if (toggle && panel) {
    const set = (open) => {
      panel.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      set(!panel.classList.contains('open'));
    });

    document.addEventListener('click', (e) => {
      if (!panel.contains(e.target)) set(false);
      else if (e.target.closest('a')) set(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
  }
</script>
