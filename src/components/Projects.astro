---
import SectionLabel from './ui/SectionLabel.astro';
import ProjectCard from './ProjectCard.astro';
import Button from './ui/Button.astro';
import { projects } from '../data/projects.js';
import { site } from '../data/site.js';
---

<section id="projects">
  <div class="head">
    <SectionLabel>Selected builds</SectionLabel>
    <h2 class="section-title">Proof</h2>
  </div>

  <div class="stack">
    {projects.map((project, i) => <ProjectCard project={project} index={i} total={projects.length} />)}
  </div>

  <div class="more">
    <p>Expanding tech horizons with new AI-fullstack projects in progress.</p>
    <Button href={site.archive}>Enter_labs ↗</Button>
  </div>
</section>

<style>
  section {
    position: relative;
    padding: 100px var(--pad-x);
    isolation: isolate;
  }

  .head {
    margin-bottom: 60px;
  }

  .head h2 {
    margin-top: 12px;
  }

  .stack {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
  }

  .more {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    padding: 70px 0 20px;
  }

  .more p {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 420px;
    margin: 0;
  }
</style>
