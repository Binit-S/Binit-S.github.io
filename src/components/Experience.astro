---
import SectionLabel from './ui/SectionLabel.astro';
import TimelineRow from './TimelineRow.astro';
import { experience, education } from '../data/experience.js';
---

<section class="on-cream">
  <SectionLabel>Timeline</SectionLabel>
  <h2 class="section-title">Experience</h2>

  <div>
    {experience.map((item) => <TimelineRow {...item} />)}
  </div>

  <div class="gap"><SectionLabel>Education</SectionLabel></div>
  <div>
    {education.map((item) => <TimelineRow {...item} />)}
  </div>
</section>

<style>
  section {
    position: relative;
    padding: 100px var(--pad-x) 110px;
  }

  h2 {
    margin: 12px 0 70px;
  }

  .gap {
    margin: 80px 0 26px;
  }
</style>
