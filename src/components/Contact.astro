---
import { Image } from 'astro:assets';
import ridge from '../assets/mountain-ridge.png';
import { site, footerNav, socials } from '../data/site.js';
---

<section id="contact">
  <div class="ridge">
    <Image src={ridge} alt="" widths={[900, 1400, 1976]} sizes="100vw" />
  </div>

  <div class="body">
    <div class="cols">
      <div>
        <p class="cta">Ready to<br /><span>build impact.</span></p>
        <a class="resume" href={site.resume} target="_blank" rel="noopener">
          <span class="box">↗</span>
          <span>DOWNLOAD RESUME</span>
          <span class="tail">↗</span>
        </a>
      </div>

      <div>
        <div class="col-head">Navigation</div>
        <div class="list">
          {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      <div>
        <div class="col-head">Contact</div>
        <div class="list">
          {
            socials.map((item) => (
              <a class="out" href={item.href} target="_blank" rel="noopener">
                {item.label}
                <span class="arrow">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="wordmark">
    <span>Binit</span>
    <a class="top" href="#hero" title="Back to top"><span>↑</span></a>
    <span>Saha</span>
  </div>
</section>

<style>
  section {
    width: 100%;
    background: var(--footer);
    overflow: hidden;
  }

  .ridge {
    background: var(--cream);
    line-height: 0;
  }

  .ridge :global(img) {
    display: block;
    width: 100%;
    margin-bottom: -1px;
  }

  .body {
    padding: 70px var(--pad-x) 0;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 90px;
  }

  .cta {
    font-size: clamp(16px, 1.3vw, 22px);
    line-height: 1.4;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 30px;
  }

  .cta span {
    color: var(--orange);
  }

  .resume {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px 6px 6px;
    background: var(--orange);
    color: var(--ink);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .resume:hover {
    background: var(--orange-hi);
    color: var(--ink);
  }

  .box {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--orange);
    border-radius: 4px;
    font-size: 12px;
  }

  .tail {
    font-size: 10px;
    color: rgba(0, 0, 0, 0.45);
  }

  .col-head {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
  }

  .list a {
    width: fit-content;
    transition: color 0.2s ease, font-style 0.2s ease;
  }

  .list a:hover {
    font-style: italic;
  }

  .out {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .arrow {
    font-size: 12px;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .out:hover .arrow {
    opacity: 1;
    transform: none;
  }

  .wordmark {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    font-size: clamp(84px, 20vw, 290px);
    height: 0.72em;
    overflow: hidden;
  }

  .wordmark span {
    font-family: var(--font-display);
    font-size: 1em;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: rgba(245, 245, 245, 0.16);
  }

  .top {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.3em;
    width: 1em;
    height: 1em;
    margin: 0.6em 0.38em 0;
    border: 0.055em solid var(--text);
    border-radius: 50%;
  }

  .top span {
    font-family: var(--font-mono);
    font-size: 0.52em;
    line-height: 1;
    color: var(--text);
  }

  .top:hover {
    background: var(--orange);
    border-color: var(--orange);
  }

  .top:hover span {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 44px;
      margin-bottom: 60px;
    }
  }
</style>
