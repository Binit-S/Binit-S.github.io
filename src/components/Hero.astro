---
import Button from './ui/Button.astro';
import { site } from '../data/site.js';
---

<section id="hero">
  <h1>
    Software<br />Engineer, building<br />with curiosity &amp;<br /><span>creativity.</span>
  </h1>

  <div class="sub" data-hero>
    <div>
      <h2>{site.role}</h2>
      <p>Still in college, still building things — mostly full-stack apps with a bit too much attention to the UI.</p>
    </div>
    <div class="ctas">
      <Button href="#projects">View Work</Button>
      <Button href={site.resume} external>Resume</Button>
    </div>
  </div>
</section>

<style>
  section {
    position: sticky;
    top: 0;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 120px var(--pad-x) 100px 15vw;
    overflow: hidden;
  }

  h1 {
    font-size: clamp(38px, 7.2vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0 0 50px;
  }

  h1 span {
    color: var(--orange);
  }

  .sub {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 32px;
    width: 100%;
    max-width: 900px;
    margin-top: 20px;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin: 0 0 8px;
  }

  p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 440px;
    margin: 0;
  }

  .ctas {
    display: flex;
    gap: 16px;
    margin-top: 10px;
  }

  @media (max-width: 720px) {
    section {
      padding: 100px var(--pad-x) 80px;
    }
  }
</style>
