---
import Tag from './ui/Tag.astro';

const { project, index, total } = Astro.props;
const rows = [
  ['Problem', project.problem],
  ['Build', project.build],
  ['Impact', project.impact],
];
---

<article data-card style={`top: ${86 + index * 20}px; z-index: ${index + 1}`}>
  <div>
    <div class="index">{String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</div>
    <h3 set:html={project.title} />
    <p class="blurb">{project.blurb}</p>

    <div class="tags">
      {project.stack.map((tech) => <Tag>{tech}</Tag>)}
    </div>

    <div class="links">
      <a href={project.repo} target="_blank" rel="noopener">VIEW_REPO ↗</a>
      <a href="#contact">ASK_ME_ABOUT_IT →</a>
    </div>
  </div>

  <div class="detail">
    {
      rows.map(([label, text]) => (
        <div class:list={['row', { impact: label === 'Impact' }]}>
          <div class="label">{label}</div>
          <div class="text">{text}</div>
        </div>
      ))
    }
  </div>
</article>

<style>
  article {
    position: sticky;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    padding: 44px 44px 48px;
    margin-bottom: 34px;
    background: var(--card);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    box-shadow: 0 -24px 70px rgba(0, 0, 0, 0.7);
    transform-origin: center top;
    will-change: transform;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 16px;
  }

  h3 {
    font-size: clamp(30px, 4.5vw, 52px);
    line-height: 1;
    margin: 0 0 18px;
  }

  .blurb {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 380px;
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 36px;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--orange);
    border-bottom: 1px solid rgba(252, 74, 37, 0.3);
    padding-bottom: 4px;
  }

  .links a:hover {
    color: var(--text);
    border-color: var(--text);
  }

  .detail {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }

  .row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 24px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }

  .text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--body);
  }

  .impact .label,
  .impact .text {
    color: var(--orange);
  }

  .impact .text {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    article {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 28px 36px;
    }

    .row {
      grid-template-columns: 80px 1fr;
      gap: 16px;
    }
  }
</style>
